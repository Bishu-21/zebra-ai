{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "zebra-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "azure:smoke": "tsx scripts/test-azure-foundry.ts",
    "azure:audit-smoke": "tsx scripts/test-azure-audit.ts",
    "resumes:legacy-audit": "tsx scripts/audit-legacy-resumes.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test tests/**/*.test.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:health": "tsx scripts/db-health.ts",
    "db:prepare": "npm run db:migrate && npm run db:health",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@azure/ai-language-text": "^1.1.0",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@google/genai": "^2.17.1",
    "@neondatabase/serverless": "1.1.0",
    "@sparticuz/chromium-min": "148.0.0",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.6.28",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "iconsax-react": "^0.0.8",
    "isomorphic-dompurify": "3.19.0",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.1",
    "next": "16.3.2",
    "openai": "^7.5.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "25.8.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "schema-dts": "^2.0.0",
    "tailwind-merge": "3.6.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "ws": "^8.21.3"
  },
  "overrides": {
    "esbuild": ">=0.27.4",
    "postcss": "^8.5.12",
    "@eslint/plugin-kit": "0.3.4",
    "dompurify": "3.4.14",
    "nanoid": "3.3.18",
    "protobufjs": "^8.0.2",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "@google/genai": false,
    "core-js": false
  }
}
