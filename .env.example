# Core application
DATABASE_URL=
DATABASE_POOL_MAX=5
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Primary AI provider: Azure Foundry (server-only)
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_OPENAI_BASE_URL=https://zebra-ai-uae-resource.services.ai.azure.com/openai/v1/
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://zebra-ai-uae-resource.services.ai.azure.com/api/projects/zebra-ai-uae
AZURE_FOUNDRY_DEPLOYMENT=zebra-gpt-5-4-mini

# Optional transient-error fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CHAT_MODEL=gemini-3.1-flash-lite
COPILOT_MODEL=gemini-3.1-flash-lite

# Optional Azure services
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Payments (required when credit purchases are enabled)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PDF rendering: use a local executable or a serverless Chromium pack URL
CHROME_EXECUTABLE_PATH=
PUPPETEER_EXECUTABLE_PATH=
CHROMIUM_PACK_URL=
